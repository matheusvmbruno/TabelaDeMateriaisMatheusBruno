<mvc:View
    controllerName="com.materiais.materiais.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page id="pageMain" title="Tabela de Materiais">
        <content>
            <VBox id="vboxMain">
                <HBox id="hboxFiltro" alignItems="Center" class="sapUiSmallMargin">
                    <Input id="inputQuantidade" placeholder="Quantidade de materiais" type="Number" width="200px"/>
                    <Button id="btnFiltrar" text="Filtrar" press=".onFiltrar" class="sapUiSmallMarginBegin"/>
                </HBox>

                <Table id="tabelaMateriais" items="{tableMaterial>/materiais}">
                    <headerToolbar>
                        <Toolbar id="toolbarTabela">
                            <Title id="titleTabela" text="Materiais"/>
                            <ToolbarSpacer id="spacerTabela"/>
                            <Button id="btnCriar" text="Criar" type="Emphasized" press=".onAbrirCriar"/>
                        </Toolbar>
                    </headerToolbar>
                    <columns>
                        <Column id="colID"><Text id="txtColID" text="ID"/></Column>
                        <Column id="colNumMat"><Text id="txtColNumMat" text="Num. Material"/></Column>
                        <Column id="colNome"><Text id="txtColNome" text="Nome"/></Column>
                        <Column id="colDescr"><Text id="txtColDescr" text="Descrição"/></Column>
                    </columns>
                    <items>
                        <ColumnListItem id="cliMaterial">
                            <cells>
                                <Text id="txtID" text="{tableMaterial>ID}"/>
                                <Text id="txtNumMat" text="{tableMaterial>NumMat}"/>
                                <Text id="txtNome" text="{tableMaterial>Nome}"/>
                                <Text id="txtDescr" text="{tableMaterial>Descr}"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
    </Page>

    <!-- Pop-up Criar Material -->
    <Dialog id="dialogCriar" title="Criar Material">
        <content>
            <VBox id="vboxDialog" class="sapUiSmallMargin">
                <Label id="labelNumMat" text="Num. Material" required="true"/>
                <Input id="inputNumMat" placeholder="Ex: 1011" type="Number" class="sapUiSmallMarginBottom"/>

                <Label id="labelNome" text="Nome" required="true"/>
                <Input id="inputNome" placeholder="Nome do material" class="sapUiSmallMarginBottom"/>

                <Label id="labelDescr" text="Descrição" required="true"/>
                <Input id="inputDescr" placeholder="Descrição do material"/>
            </VBox>
        </content>
        <beginButton>
            <Button id="btnConfirmarCriar" text="Confirmar" type="Emphasized" press=".onConfirmarCriar"/>
        </beginButton>
        <endButton>
            <Button id="btnCancelarCriar" text="Cancelar" press=".onCancelarCriar"/>
        </endButton>
    </Dialog>

</mvc:View>